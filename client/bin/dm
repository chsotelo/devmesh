#!/usr/bin/env bash
# dm — devmesh client: control every machine from any device.
# macOS ships bash 3.2: re-run under Homebrew's bash 5 (this block is bash-3 safe).
if [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "dm needs bash >= 4 (brew install bash)" >&2
  exit 1
fi
set -euo pipefail
export DM_SELF
DM_SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

dm_share_dir() {
  local here
  if [[ -n ${DM_SHARE:-} ]]; then
    printf '%s\n' "$DM_SHARE"
    return
  fi
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  if [[ -d $here/../lib && -f $here/../lib/dm_core.sh ]]; then
    (cd "$here/.." && pwd) # running from a checkout: client/bin/dm
  elif [[ -d ${PREFIX:-/nonexistent}/share/devmesh ]]; then
    printf '%s/share/devmesh\n' "$PREFIX"
  elif [[ -d $HOME/.local/share/devmesh/lib ]]; then
    printf '%s/.local/share/devmesh\n' "$HOME" # macOS (user-level install)
  else
    printf '/usr/local/share/devmesh\n'
  fi
}

for _lib in dm_core dm_remote dm_files dm_admin dm_repoint dm_trust dm_notify dm_power dm_herdr; do
  # shellcheck source=/dev/null
  source "$(dm_share_dir)/lib/$_lib.sh"
done
unset _lib

dm_dispatch() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    go | m) dm_go "$@" ;;
    use) dm_use "$@" ;;
    power) dm_power_cmd "$@" ;;
    wake) dm_wake "$@" ;;
    herdr) dm_herdr "$@" ;;
    send) dm_send "$@" ;;
    fetch) dm_fetch ;;
    port) dm_port "$@" ;;
    mesh) dm_mesh ;;
    devices | ls) dm_devices ;;
    add) dm_add "$@" ;;
    rm) dm_rm ;;
    refresh) dm_refresh ;;
    repoint) dm_repoint "$@" ;;
    approve) dm_approve "$@" ;;
    trust) dm_trust "$@" ;;
    update) dm_update ;;
    version) dm_version ;;
    notify) dm_notify "$@" ;;
    help | -h | --help) dm_help ;;
    # Kept so installs from before 0.13 do not break: Claude hooks that still call
    # "dm agent", and VS Code terminal profiles that still start "dm _vscode-shell".
    agent) return 0 ;;
    _vscode-shell) exec "${SHELL:-/bin/sh}" -l ;;
    # Machine-side helpers, called over SSH by other devices.
    _clients) dm_remote_clients "$@" ;;
    _projects) dm_remote_projects ;;
    _attach) dm_remote_attach "$@" ;;
    _ports) dm_remote_ports ;;
    _recent) dm_remote_recent ;;
    _dest) dm_remote_dest "$@" ;;
    _wol) dm_remote_wol "$@" ;;
    _power) dm_power "$@" ;;
    _power_do) dm_power_do "$@" ;;
    _herdr) dm_remote_herdr "$@" ;;
    _notify) dm_notify_hook ;;
    *) dm_die "unknown command: $cmd (try: dm help)" ;;
  esac
}

dm_main() {
  # "agent" (old Claude hooks) and _vscode-shell (old VS Code profiles) run on every prompt
  # or terminal: both stay free of config and network.
  if [[ -n ${1:-} && ${1:-} != agent && ${1:-} != help && ${1:-} != version && ${1:-} != _vscode-shell ]]; then
    dm_load_conf
  fi
  dm_dispatch "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  dm_main "$@"
fi
