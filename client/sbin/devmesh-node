#!/usr/bin/env bash
# devmesh-node — root helper on each machine, driven by systemd units.
#   tunnel      reverse SSH tunnel to the hub (path B); exec'd by devmesh-tunnel.service
#   keys-sync   pull authorized client keys from the hub (every minute)
#   reresolve   follow the hub to a new IP after a migration (every 2 minutes)
#   hubwatch    alert via ntfy.sh when the hub itself is down (optional)
#   update      install a newer client bundle signed by an approver (every 30 minutes)
#   mesh        mesh firewall: status | open <tcp|udp>/<port[-port]> | close <...> (root)
#   lan         direct ssh/mosh on trusted LANs: status | trust | forget | apply (root)
set -euo pipefail

NODE_ETC=${NODE_ETC:-/etc/devmesh}
NODE_STATE=${NODE_STATE:-/var/lib/devmesh}
NODE_RUN=${NODE_RUN:-/run/devmesh}

node_die() {
  printf 'devmesh-node: %s\n' "$*" >&2
  exit 1
}

node_load() {
  # shellcheck source=/dev/null
  source "$NODE_ETC/node.conf"
  node_ssh_opts=(
    -i "$NODE_ETC/tunnel_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes
    -o UserKnownHostsFile="$NODE_ETC/known_hosts" -o StrictHostKeyChecking=yes
    -o HostKeyAlias="$DM_HUB_HOST" -o ServerAliveInterval=15 -o ServerAliveCountMax=3
    -o ConnectTimeout=10 -p "${DM_HUB_SSH_PORT:-2222}"
  )
}

# A removed machine keeps its services running. Retrying every few seconds with a key
# the hub no longer accepts would let fail2ban ban this network's public IP (and with it
# every other device behind it). Once the hub says "Permission denied", back off to one
# attempt per hour; the marker clears on the next successful login.
NODE_BACKOFF=${NODE_BACKOFF:-3600}
node_revoked_marker() { printf '%s/revoked\n' "$NODE_STATE"; }

node_is_backing_off() {
  local m age
  m=$(node_revoked_marker)
  [[ -e $m ]] || return 1
  age=$(($(date +%s) - $(cat "$m" 2>/dev/null || echo 0)))
  ((age < NODE_BACKOFF))
}

# node_hub_ssh OUT CMD... — ssh to the hub, recording revocation from stderr.
node_hub_ssh() {
  local out=$1 err rc=0
  shift
  err=$(mktemp)
  # shellcheck disable=SC2029 # arguments are meant for the hub
  ssh "${node_ssh_opts[@]}" "tunnel@$DM_HUB_HOST" "$@" >"$out" 2>"$err" || rc=$?
  if ((rc != 0)) && grep -q 'Permission denied' "$err"; then
    mkdir -p "$NODE_STATE"
    date +%s >"$(node_revoked_marker)"
  elif ((rc == 0)); then
    rm -f "$(node_revoked_marker)"
  fi
  cat "$err" >&2
  rm -f "$err"
  return "$rc"
}

node_tunnel() {
  [[ $DM_PORT =~ ^[0-9]+$ ]] || node_die "no tunnel port configured"
  if node_is_backing_off; then
    echo "devmesh-node: hub rejected this machine; retrying in at most ${NODE_BACKOFF}s" >&2
    sleep "$NODE_BACKOFF"
    exit 0
  fi
  # Preflight on the forced command: tells "revoked" apart from "hub unreachable".
  node_hub_ssh /dev/null keys || {
    sleep 5
    exit 1
  }
  exec ssh -N "${node_ssh_opts[@]}" -o ExitOnForwardFailure=yes \
    -R "localhost:$DM_PORT:localhost:${DM_LOCAL_SSH_PORT:-22}" "tunnel@$DM_HUB_HOST"
}

# Only accept lines that are bare ed25519 keys tagged devmesh:<name> (and at least one).
node_valid_keys() {
  local re='^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43} devmesh:[a-z][a-z0-9-]*$'
  grep -q . "$1" || return 1
  ! grep -v '^$' "$1" | grep -Evq "$re"
}

# DM_TRUST=signed: the hub's bundle is only a carrier. A key is installed when an approver in
# the local allowed_signers signed it (or is itself an approver); everything else is dropped
# and logged. The result replaces the bundle file, ready for node_valid_keys.
node_signed_keys() {
  local bundle=$1 lib=${NODE_SHARE:-/usr/local/share/devmesh}/lib/trust_common.sh out rc=0 kind name key
  [[ -r $lib ]] || node_die "signed mode needs $lib"
  # shellcheck source=/dev/null
  source "$lib"
  out=$(tr_process_bundle "$NODE_ETC/allowed_signers" "$bundle" 1) || rc=$?
  ((rc != 3)) || node_die "signed mode but no $NODE_ETC/allowed_signers (run: dm trust pin); keeping the current keys"
  ((rc == 0)) || node_die "hub returned an unparseable bundle; keeping the current keys"
  while read -r kind name key; do
    if [[ $kind == client || $kind == signer ]]; then printf '%s devmesh:%s\n' "$key" "$name"; fi
  done <<<"$out" | awk '!seen[$0]++' >"$bundle"
}

# One rule for every verifier (trust_common.sh tr_mode): signed when DM_TRUST=signed or an
# allowed_signers exists. Without the library the node cannot verify, so it refuses when signed.
node_trust_mode() {
  local lib=${NODE_SHARE:-/usr/local/share/devmesh}/lib/trust_common.sh
  if [[ -r $lib ]]; then
    # shellcheck source=/dev/null
    source "$lib"
    tr_mode "$NODE_ETC/allowed_signers" "${DM_TRUST:-}"
  elif [[ ${DM_TRUST:-open} == signed || -s $NODE_ETC/allowed_signers ]]; then
    node_die "signed mode needs $lib"
  else
    printf 'open\n'
  fi
}

NODE_TMP=""
node_keys_sync() {
  local target="$NODE_ETC/clients.pub" cmd=keys
  # Global, not local: the EXIT trap runs after this function has returned (set -u).
  NODE_TMP=$(mktemp "$target.XXXXXX")
  trap 'rm -f "${NODE_TMP:-}"' EXIT
  local tmp=$NODE_TMP
  local version mode
  if node_is_backing_off; then
    return 0
  fi
  mode=$(node_trust_mode) || node_die "cannot decide the trust mode"
  [[ $mode != signed ]] || cmd=keys2
  version=$(cat "${NODE_SHARE:-/usr/local/share/devmesh}/VERSION" 2>/dev/null || printf '%s' "${DM_VERSION:-0.0.0}")
  # "keys <version>" also reports the installed client version (shown by "devmesh ls").
  node_hub_ssh "$tmp" "$cmd" "$version" || node_die "cannot fetch keys from hub"
  [[ $cmd != keys2 ]] || node_signed_keys "$tmp"
  node_valid_keys "$tmp" || node_die "hub returned an invalid key list; keeping the current one"
  cmp -s "$tmp" "$target" && return 0
  chmod 0644 "$tmp"
  mv -f "$tmp" "$target"
  trap - EXIT
}

node_hub_handshake_age() {
  local hs
  hs=$(wg show "$DM_WG_IFACE" latest-handshakes 2>/dev/null | awk -v k="$DM_HUB_WG_PUB" '$1 == k {print $2}')
  [[ $hs =~ ^[0-9]+$ && $hs -gt 0 ]] || {
    printf '999999\n'
    return
  }
  printf '%s\n' $(($(date +%s) - hs))
}

node_reresolve() {
  (($(node_hub_handshake_age) > 135)) || return 0
  wg set "$DM_WG_IFACE" peer "$DM_HUB_WG_PUB" endpoint "$DM_HUB_HOST:$DM_WG_PORT"
}

node_hub_ok() {
  (($(node_hub_handshake_age) < 180)) && return 0
  timeout 5 bash -c "exec 3<>/dev/tcp/$DM_HUB_HOST/${DM_HUB_SSH_PORT:-2222}" 2>/dev/null
}

# State: "fails <n> <alerted>". Alert after 3 consecutive failures, once; notify recovery.
node_hubwatch() {
  [[ ${DM_WATCH_TOPIC:--} != - ]] || return 0
  local file="$NODE_STATE/hubwatch" fails=0 alerted=0
  mkdir -p "$NODE_STATE"
  read -r _ fails alerted 2>/dev/null <"$file" || true
  if node_hub_ok; then
    if ((alerted)); then
      curl -fsS -m 10 -H "Title: devmesh hub is back" -d "hub reachable again (seen by $DM_NAME)" \
        "https://ntfy.sh/$DM_WATCH_TOPIC" >/dev/null || true
    fi
    printf 'fails 0 0\n' >"$file"
    return 0
  fi
  fails=$((fails + 1))
  if ((fails >= 3 && ! alerted)); then
    curl -fsS -m 10 -H "Title: devmesh hub is down" -H "Tags: red_circle" -d "hub unreachable (seen by $DM_NAME)" \
      "https://ntfy.sh/$DM_WATCH_TOPIC" >/dev/null && alerted=1
  fi
  printf 'fails %s %s\n' "$fails" "$alerted" >"$file"
}

# Mesh firewall (Linux). The rules and the entry validation live in devmesh-node-fw.
node_fw_script() { printf '%s/devmesh-node-fw\n' "$(dirname "${BASH_SOURCE[0]}")"; }

node_mesh_list() {
  local fw
  fw=$(node_fw_script)
  [[ -r $fw ]] || node_die "missing $fw"
  # shellcheck source=/dev/null
  (source "$fw" && NODE_ETC=$NODE_ETC fw_open_list)
}

# node_mesh_write LIST... — replace DM_MESH_OPEN in node.conf (the line is dropped when empty).
node_mesh_write() {
  local conf="$NODE_ETC/node.conf" tmp
  tmp=$(mktemp "$conf.XXXXXX")
  grep -v '^DM_MESH_OPEN=' "$conf" >"$tmp" || true
  (($#)) && printf 'DM_MESH_OPEN="%s"\n' "$*" >>"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$conf"
}

node_mesh() {
  local sub=${1:-status} arg=${2:-} fw entry entries=() found=0 kept=()
  fw=$(node_fw_script)
  # shellcheck source=/dev/null
  source "$fw"
  case $sub in
    status)
      printf 'open on the mesh: ssh (tcp/22), mosh (udp/60000-61000), ping\n'
      while read -r entry; do
        [[ -z $entry ]] || printf 'open on the mesh: %s\n' "$entry"
      done < <(node_mesh_list)
      return 0
      ;;
    open | close) ;;
    *) node_die "usage: devmesh-node mesh status|open <proto/port>|close <proto/port>" ;;
  esac
  [[ $EUID -eq 0 || ${DEVMESH_ALLOW_NONROOT:-0} == 1 ]] || node_die "mesh $sub needs root (use sudo)"
  fw_valid_entry "$arg" || node_die "invalid port '$arg' (examples: tcp/8000, udp/5353, tcp/8000-8010)"
  while read -r entry; do
    [[ -z $entry ]] || entries+=("$entry")
  done < <(node_mesh_list)
  for entry in ${entries[@]+"${entries[@]}"}; do
    if [[ $entry == "$arg" ]]; then found=1; else kept+=("$entry"); fi
  done
  if [[ $sub == open ]]; then
    kept=(${entries[@]+"${entries[@]}"})
    ((found)) || kept+=("$arg")
  fi
  node_mesh_write ${kept[@]+"${kept[@]}"}
  # Reapply now when the interface is up; otherwise the next wg-quick up does it.
  if wg show "$DM_WG_IFACE" >/dev/null 2>&1; then
    NODE_ETC=$NODE_ETC bash "$fw" up "$DM_WG_IFACE"
  fi
  node_mesh status
}

# --- Path L: trusted LANs ----------------------------------------------------------------
# A trusted LAN is "<cidr>@<router MAC>" (DM_LAN_TRUST in node.conf): the subnet alone would
# also match a cafe that uses the same range. While the machine is on one, $NODE_RUN/lan holds
# "<its ip> <cidr> <dev>": sshd binds that address and DEVMESH-LAN accepts that subnet on that
# interface. Anywhere else the file is empty and sshd is bound to the mesh and localhost only.
readonly NODE_MAC_RE='^([0-9a-f]{2}:){5}[0-9a-f]{2}$'

# node_gw_mac GW DEV — the router's MAC from the neighbour table (lowercase).
node_gw_mac() {
  ip -4 neigh show "$1" dev "$2" 2>/dev/null |
    awk '{for (i = 1; i < NF; i++) if ($i == "lladdr") {print tolower($(i + 1)); exit}}'
}

# node_lan_current — "ip cidr dev router-mac" of the network the default route uses now.
node_lan_current() {
  local gw="" dev="" cidr ip mac
  read -r gw dev < <(ip -4 route show default 2>/dev/null |
    awk '{for (i = 1; i < NF; i++) { if ($i == "via") g = $(i + 1); if ($i == "dev") d = $(i + 1) } print g, d; exit}') || true
  [[ -n $gw && -n $dev ]] || return 1
  cidr=$(ip -4 -o route show dev "$dev" scope link 2>/dev/null | awk '$1 ~ /\// {print $1; exit}')
  ip=$(ip -4 -o route get "$gw" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
  mac=$(node_gw_mac "$gw" "$dev")
  if [[ -z $mac ]]; then
    ping -c 1 -W 1 "$gw" >/dev/null 2>&1 || true
    mac=$(node_gw_mac "$gw" "$dev")
  fi
  [[ -n $cidr && -n $ip && $mac =~ $NODE_MAC_RE ]] || return 1
  fw_valid_lan "$cidr" || return 1
  printf '%s %s %s %s\n' "$ip" "$cidr" "$dev" "$mac"
}

# node_lan_list — DM_LAN_TRUST from node.conf, one valid "<cidr>@<mac>" per line.
node_lan_list() {
  local v e
  v=$(sed -n 's/^DM_LAN_TRUST="\(.*\)"$/\1/p' "$NODE_ETC/node.conf" 2>/dev/null)
  for e in $v; do
    fw_valid_lan "${e%@*}" && [[ ${e#*@} =~ $NODE_MAC_RE ]] && printf '%s\n' "$e"
  done
  return 0
}

# node_lan_match — "ip cidr dev" when the current network is a trusted one.
node_lan_match() {
  local ip cidr dev mac e
  read -r ip cidr dev mac < <(node_lan_current) || return 1
  while read -r e; do
    [[ $e == "$cidr@$mac" ]] && printf '%s %s %s\n' "$ip" "$cidr" "$dev" && return 0
  done < <(node_lan_list)
  return 1
}

# node_lan_write LIST... — replace DM_LAN_TRUST in node.conf (the line is dropped when empty).
node_lan_write() {
  local conf="$NODE_ETC/node.conf" tmp
  tmp=$(mktemp "$conf.XXXXXX")
  grep -v '^DM_LAN_TRUST=' "$conf" >"$tmp" || true
  (($#)) && printf 'DM_LAN_TRUST="%s"\n' "$*" >>"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$conf"
}

# node_sshd_refresh — re-render sshd's drop-in from the current state (restart only on change).
node_sshd_refresh() {
  local share=${NODE_SHARE:-/usr/local/share/devmesh}
  [[ -r $share/lib/bootstrap_linux.sh ]] || return 0
  (
    export DM_DIST_DIR=$share BS_ETC=$NODE_ETC BS_RUN=$NODE_RUN
    # shellcheck source=/dev/null
    source "$share/lib/bootstrap_linux.sh"
    linux_sshd_refresh
  )
}

# node_lan_apply — follow the network (timer + after every change). Joining a trusted LAN:
# firewall first, then sshd binds. Leaving it: sshd unbinds first, then the firewall closes.
node_lan_apply() {
  local fw new
  fw=$(node_fw_script)
  new=$(node_lan_match) || new=""
  install -d -m 0755 "$NODE_RUN"
  printf '%s\n' "$new" >"$NODE_RUN/lan.tmp"
  mv -f "$NODE_RUN/lan.tmp" "$NODE_RUN/lan"
  if [[ -n $new ]]; then
    NODE_ETC=$NODE_ETC NODE_RUN=$NODE_RUN bash "$fw" lan
    node_sshd_refresh
  else
    node_sshd_refresh
    NODE_ETC=$NODE_ETC NODE_RUN=$NODE_RUN bash "$fw" lan
  fi
}

# devmesh-node lan status|trust|forget|apply — the networks whose devices reach this
# machine's ssh/mosh directly (no hub). "trust" adds the network the machine is on now.
node_lan() {
  local sub=${1:-status} fw cur ip cidr dev mac e kept=() n=0
  fw=$(node_fw_script)
  # shellcheck source=/dev/null
  source "$fw"
  case $sub in
    status)
      while read -r e; do
        [[ -z $e ]] || printf 'trusted LAN: %s (router %s)\n' "${e%@*}" "${e#*@}"
      done < <(node_lan_list)
      if cur=$(node_lan_match); then
        printf 'direct now: yes, on %s\n' "$cur"
      else
        printf 'direct now: no (this network is not trusted)\n'
      fi
      return 0
      ;;
    trust | forget | apply) ;;
    *) node_die "usage: devmesh-node lan status|trust|forget|apply" ;;
  esac
  [[ $EUID -eq 0 || ${DEVMESH_ALLOW_NONROOT:-0} == 1 ]] || node_die "lan $sub needs root (use sudo)"
  case $sub in
    apply)
      node_lan_apply
      return 0
      ;;
    trust)
      cur=$(node_lan_current) || node_die "cannot read this network (default route, subnet and router MAC)"
      read -r ip cidr dev mac <<<"$cur"
      while read -r e; do
        [[ -z $e ]] || kept+=("$e")
        [[ $e != "$cidr@$mac" ]] || n=1
      done < <(node_lan_list)
      ((n)) || kept+=("$cidr@$mac")
      printf 'trusting %s on %s (router %s): devices on it reach %s directly\n' "$cidr" "$dev" "$mac" "$ip"
      ;;
    forget) kept=() ;;
  esac
  node_lan_write ${kept[@]+"${kept[@]}"}
  node_lan_apply
  node_lan status
}

# node_newer A B: A is a version strictly newer than B.
node_newer() {
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $1 != "$2" ]] &&
    [[ $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1) == "$1" ]]
}

# Unattended update: only in signed mode, and only a bundle that an approver in the local
# allowed_signers signed (root-owned: the hub cannot change it). The hub serves the signed
# bundle alone on this channel; without one there is nothing to do.
node_update() {
  local share=${NODE_SHARE:-/usr/local/share/devmesh} work remote installed version sha
  node_is_backing_off && return 0
  [[ $(node_trust_mode) == signed ]] || return 0
  [[ -s $NODE_ETC/allowed_signers ]] || node_die "signed mode but no $NODE_ETC/allowed_signers (run: dm trust pin)"
  NODE_TMP=$(mktemp -d)
  trap 'rm -rf "${NODE_TMP:-}"' EXIT
  work=$NODE_TMP
  node_hub_ssh "$work/version" dist-version 2>/dev/null || return 0
  remote=$(head -n1 "$work/version")
  installed=$(cat "$share/VERSION" 2>/dev/null || printf '0.0.0')
  node_newer "$remote" "$installed" || return 0
  node_hub_ssh "$work/dist.tgz" dist || node_die "cannot download the client bundle"
  node_hub_ssh "$work/dist.sig" dist-sig || node_die "cannot download the bundle signature"
  # shellcheck source=/dev/null
  source "$share/lib/trust_common.sh"
  version=$(tar -xzOf "$work/dist.tgz" VERSION 2>/dev/null | head -n1)
  [[ $version == "$remote" ]] || node_die "the bundle is ${version:-unreadable}, the hub announced $remote: nothing installed"
  sha=$(tr_sha256 "$work/dist.tgz")
  tr_verify "$NODE_ETC/allowed_signers" "$(cat "$work/dist.sig")" "$(tr_msg bundle "$version" "$sha")" >/dev/null ||
    node_die "the client bundle $version is not signed by an approver: nothing installed"
  tar -xzf "$work/dist.tgz" -C "$work"
  # shellcheck disable=SC2016 # expanded by the child shell
  DM_DIST_DIR="$work/client" DM_VERSION="$version" bash -c \
    'source "$DM_DIST_DIR/lib/bootstrap_linux.sh" && linux_install_client && linux_sshd_refresh && linux_enable_update'
  echo "devmesh-node: client updated $installed -> $version"
}

node_main() {
  case ${1:-} in
    tunnel | keys-sync | reresolve | hubwatch | mesh | lan | update) node_load ;;
    *)
      echo "usage: devmesh-node tunnel|keys-sync|reresolve|hubwatch|mesh|lan|update" >&2
      exit 2
      ;;
  esac
  case $1 in
    tunnel) node_tunnel ;;
    keys-sync) node_keys_sync ;;
    reresolve) node_reresolve ;;
    hubwatch) node_hubwatch ;;
    update) node_update ;;
    mesh) shift && node_mesh "$@" ;;
    lan) shift && node_lan "$@" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  node_main "$@"
fi
