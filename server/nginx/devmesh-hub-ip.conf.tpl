# Generated by devmesh install-hub (IP mode, self-signed certificate) for @@HUB_HOST@@.
server {
    # Own port: never the default server of 80/443, which may belong to other sites.
    listen @@HTTPS_PORT@@ ssl http2;
    listen [::]:@@HTTPS_PORT@@ ssl http2;
    server_name _;
    ssl_certificate @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;

    # One-use join scripts. No listing, never cached.
    location /j/ {
        alias @@WEBROOT@@/j/;
        autoindex off;
        access_log off; # the URL carries the one-use code
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        limit_except GET { deny all; }
    }

    # ntfy (auth enforced by ntfy itself: deny-all + tokens). Alerts are posted locally.
    location / {
        proxy_pass http://127.0.0.1:2586;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3h;
        proxy_buffering off;
        client_max_body_size 1m;
    }
}
