# Generated by devmesh install-hub for @@HUB_HOST@@.
server {
    listen 80;
    listen [::]:80;
    server_name @@HUB_HOST@@;
    location /.well-known/acme-challenge/ { root @@WEBROOT@@/acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@HUB_HOST@@;
    ssl_certificate @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;

    # One-use join scripts. No listing, never cached.
    location /j/ {
        alias @@WEBROOT@@/j/;
        autoindex off;
        access_log off; # the URL carries the one-use code
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        limit_except GET { deny all; }
    }

    # ntfy (auth enforced by ntfy itself: deny-all + tokens).
    location / {
        proxy_pass http://127.0.0.1:2586;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3h;
        proxy_buffering off;
        client_max_body_size 1m;
    }
}
