#!/usr/bin/env bash
# devmesh-fw up|down <iface> — wg-quick PostUp/PostDown hook on the hub.
# 1. Forwarding only between devmesh peers (iface -> same iface). On Docker hosts the rules
#    must live in DOCKER-USER: Docker sets FORWARD to DROP and evaluates its chains first.
#    There, "-i iface ! -o iface -j DROP" keeps published containers away from the mesh.
# 2. INPUT from the mesh: only established traffic, ping, the devmesh sshd port and the
#    optional HUB_OPEN_PORTS from hub.conf (services on the hub itself, mesh-only).
#    "devmesh-fw up <iface>" is idempotent (flush + rebuild), so it also re-applies the rules.
# Every rule is either in DEVMESH-HUB-IN or matches the devmesh interface; nothing else is touched.
set -euo pipefail

action=${1:-}
iface=${2:-}
[[ $iface =~ ^[a-z][a-z0-9]{0,14}$ ]] || {
  echo "usage: devmesh-fw up|down <iface>" >&2
  exit 2
}

hub_chain=DEVMESH-HUB-IN
chain=FORWARD
iptables -n -L DOCKER-USER >/dev/null 2>&1 && chain=DOCKER-USER
rule=(-i "$iface" -o "$iface" -j ACCEPT)
drop_rule=(-i "$iface" ! -o "$iface" -j DROP)
hook_rule=(-i "$iface" -j "$hub_chain")

# HUB_SSH_PORT from hub.conf (same file the hub reads); 2222 when absent or not a port.
hub_ssh_port() {
  local conf=${DEVMESH_ETC:-/etc/devmesh}/hub.conf p=""
  [[ -r $conf ]] && p=$(sed -n 's/^HUB_SSH_PORT=//p' "$conf" | tail -n 1 | tr -d "\"'")
  if [[ $p =~ ^[0-9]{1,5}$ ]] && ((p >= 1 && p <= 65535)); then
    printf '%s\n' "$p"
  else
    printf '2222\n'
  fi
}

# Last value of KEY in hub.conf, quotes stripped.
hub_conf_value() {
  local conf=${DEVMESH_ETC:-/etc/devmesh}/hub.conf
  [[ -r $conf ]] && sed -n "s/^$1=//p" "$conf" | tail -n 1 | tr -d "\"'" || true
}

# HUB_OPEN_PORTS: "port" (tcp) or "port/udp" entries separated by spaces or commas.
# Prints "proto port" per valid entry; invalid ones are skipped with a warning.
hub_open_ports() {
  local entry port proto
  for entry in $(hub_conf_value HUB_OPEN_PORTS | tr ',' ' '); do
    port=${entry%%/*}
    proto=tcp
    [[ $entry == */* ]] && proto=${entry#*/}
    if [[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) && [[ $proto == tcp || $proto == udp ]]; then
      printf '%s %s\n' "$proto" "$((10#$port))"
    else
      echo "devmesh-fw: ignoring invalid HUB_OPEN_PORTS entry '$entry'" >&2
    fi
  done
}

case $action in
  up)
    iptables -C "$chain" "${rule[@]}" 2>/dev/null || iptables -I "$chain" 1 "${rule[@]}"
    if [[ $chain == DOCKER-USER ]]; then
      iptables -C "$chain" "${drop_rule[@]}" 2>/dev/null || iptables -I "$chain" 1 "${drop_rule[@]}"
    fi
    iptables -n -L "$hub_chain" >/dev/null 2>&1 || iptables -N "$hub_chain"
    iptables -F "$hub_chain"
    iptables -A "$hub_chain" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    iptables -A "$hub_chain" -p icmp --icmp-type echo-request -j ACCEPT
    iptables -A "$hub_chain" -p tcp --dport "$(hub_ssh_port)" -j ACCEPT
    while read -r proto port; do
      iptables -A "$hub_chain" -p "$proto" --dport "$port" -j ACCEPT
    done < <(hub_open_ports)
    iptables -A "$hub_chain" -j DROP
    iptables -C INPUT "${hook_rule[@]}" 2>/dev/null || iptables -I INPUT 1 "${hook_rule[@]}"
    ;;
  down)
    for c in FORWARD DOCKER-USER; do
      while iptables -C "$c" "${rule[@]}" 2>/dev/null; do
        iptables -D "$c" "${rule[@]}"
      done
      while iptables -C "$c" "${drop_rule[@]}" 2>/dev/null; do
        iptables -D "$c" "${drop_rule[@]}"
      done
    done
    while iptables -C INPUT "${hook_rule[@]}" 2>/dev/null; do
      iptables -D INPUT "${hook_rule[@]}"
    done
    if iptables -n -L "$hub_chain" >/dev/null 2>&1; then
      iptables -F "$hub_chain"
      iptables -X "$hub_chain"
    fi
    ;;
  *)
    echo "usage: devmesh-fw up|down <iface>" >&2
    exit 2
    ;;
esac
