[Unit]
Description=devmesh sshd (restricted accounts only, own port and host key)
After=network.target
StartLimitIntervalSec=0

[Service]
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/devmesh/sshd_config
ExecStart=/usr/sbin/sshd -D -f /etc/devmesh/sshd_config
ExecReload=/usr/sbin/sshd -t -f /etc/devmesh/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
