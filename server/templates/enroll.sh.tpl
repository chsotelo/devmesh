#!/bin/sh
# devmesh join for "@@NAME@@" — generated by the hub; works once and expires.
#   curl -fsSL https://@@HUB_HOST@@/j/@@CODE@@ | sh -s <secret>
# (IP mode: the line also carries --pinnedpubkey and -k; DM_HUB_PIN below is the same pin.)
# POSIX launcher: detects the platform and runs the matching bootstrap with the right
# shell (Linux: sudo bash · macOS: Homebrew bash, no sudo · Android/Termux: bash).
# Linux and macOS join as machines (their terminals are shared); Termux as a phone.
# Carries only public data and a throwaway enrollment key that is encrypted with the
# secret; every device key is generated on the device itself.
# Everything runs inside main(), called on the last line: sh reads the whole script before
# executing anything (a truncated download runs nothing), and child processes cannot eat
# the rest of the piped script from stdin.
set -eu

main() {
secret=${1:-}
if [ -z "$secret" ]; then
  echo "devmesh: missing secret. Paste the whole line printed by 'dm add'." >&2
  exit 1
fi

if [ -n "${DM_FORCE_PLATFORM:-}" ]; then
  platform=$DM_FORCE_PLATFORM
elif [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux ]; then
  platform=termux
elif [ "$(uname -s)" = Darwin ]; then
  platform=macos
else
  platform=linux
fi

boot=$(mktemp "${TMPDIR:-/tmp}/devmesh-join.XXXXXX")
trap 'rm -f "$boot"' EXIT INT TERM
cat >"$boot" <<'DEVMESH_BOOTSTRAP'
set -euo pipefail
platform=$1
case $platform in
  linux) kind=machine ;;
  termux) kind=phone ;;
  macos) kind=machine ;;
  *) echo "devmesh: unknown platform $platform" >&2; exit 1 ;;
esac

export DM_NAME='@@NAME@@' DM_KIND="$kind" DM_IP='@@IP@@' DM_LAN='@@LAN@@'
export DM_WATCH_TOPIC='@@WATCH_TOPIC@@' DM_CODE='@@CODE@@'
export DM_HUB_PIN='@@HUB_PIN@@'
export DM_HUB_HOST='@@HUB_HOST@@' DM_HUB_IP='@@HUB_IP@@' DM_WG_PORT='@@WG_PORT@@' DM_HUB_SSH_PORT='@@HUB_SSH_PORT@@'
export DM_WG_IFACE='@@WG_IFACE@@' DM_SUBNET_PREFIX='@@SUBNET_PREFIX@@'
export DM_OWNER='@@OWNER@@'
export DM_HUB_WG_PUB='@@HUB_WG_PUB@@' DM_HUB_HOST_KEY='@@HUB_HOST_KEY@@' DM_VERSION='@@VERSION@@'

umask 077
dm_work=$(mktemp -d)
trap 'rm -rf "$dm_work"' EXIT

cat >"$dm_work/enroll.key" <<'DEVMESH_KEY'
@@ENROLL_KEY@@
DEVMESH_KEY

cat >"$dm_work/signers" <<'DEVMESH_SIGNERS'
@@SIGNERS@@
DEVMESH_SIGNERS
export DM_SIGNERS_FILE="$dm_work/signers"
cat >"$dm_work/epoch" <<'DEVMESH_EPOCH'
@@EPOCH@@
DEVMESH_EPOCH
export DM_EPOCH_FILE="$dm_work/epoch"

base64 -d >"$dm_work/dist.tgz" <<'DEVMESH_DIST'
@@CLIENT_DIST@@
DEVMESH_DIST
tar -xzf "$dm_work/dist.tgz" -C "$dm_work"

export DM_ENROLL_PASS="$2" DM_ENROLL_KEY_FILE="$dm_work/enroll.key" DM_DIST_DIR="$dm_work/client"
# shellcheck source=/dev/null
source "$dm_work/client/lib/bootstrap_$platform.sh"
bootstrap_main
DEVMESH_BOOTSTRAP

# Prompts (sudo password, "press Enter") must come from the terminal, not from the pipe.
input=/dev/null
if (: </dev/tty) 2>/dev/null; then input=/dev/tty; fi

case $platform in
  linux)
    if [ "$(id -u)" = 0 ]; then
      echo "devmesh: run this as your normal user (it asks for sudo itself)." >&2
      exit 1
    fi
    sudo bash "$boot" linux "$secret" <"$input"
    ;;
  macos)
    bash5=""
    for b in "$(brew --prefix 2>/dev/null)/bin/bash" /opt/homebrew/bin/bash /usr/local/bin/bash; do
      [ -x "$b" ] && bash5=$b && break
    done
    if [ -z "$bash5" ]; then
      echo "devmesh: needs Homebrew's bash: brew install bash" >&2
      exit 1
    fi
    "$bash5" "$boot" macos "$secret" <"$input"
    ;;
  *) bash "$boot" "$platform" "$secret" <"$input" ;;
esac
}

main "$@"
