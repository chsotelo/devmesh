#!/usr/bin/env bats
# install-hub.sh --container: no systemd, firewall, ufw, fail2ban or timers; the rest is rendered.

load helpers

setup() {
  setup_hub
  local t=$BATS_TEST_TMPDIR b
  b=$t/bin
  mkdir -p "$b" "$t/lib" "$t/sbin" "$t/conf.d" "$t/sudoers.d" "$t/ntfy-etc" "$t/rundir"
  export PATH="$b:$PATH"
  # Everything install-hub must not touch in a container records itself and reports "active".
  for c in systemctl ufw fail2ban-client iptables-save apt-get dpkg modprobe; do
    printf '#!/usr/bin/env bash\nprintf "%s %%s\\n" "$*" >>"$STUB_LOG"\n[[ $1 == status ]] && echo "Status: active"\nexit 0\n' "$c" >"$b/$c"
  done
  # Harmless stand-ins for what a container image provides and the test host may lack.
  for c in useradd usermod visudo ip; do printf '#!/usr/bin/env bash\nexit 0\n' >"$b/$c"; done
  printf '#!/usr/bin/env bash\nexit 0\n' >"$b/sshd"
  printf '#!/usr/bin/env bash\n[[ $1 == -t ]] && exit 0\nexit 0\n' >"$b/nginx"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$NTFY_VERSION_STUB"\n' >"$b/dpkg-query"
  printf '#!/usr/bin/env bash\necho "v1.3.2"\n' >"$b/age"
  printf '#!/usr/bin/env bash\ncase "$1 $2" in "token add") echo "token tk_abcdefghijklmnopqrstuvwxyz0123";; esac\nexit 0\n' >"$b/ntfy"
  chmod +x "$b"/*
  export NTFY_VERSION_STUB
  NTFY_VERSION_STUB=$(sed -n 's/^readonly NTFY_VERSION=//p' "$REPO/server/install/web.sh")
  export DEVMESH_LIB=$t/lib DEVMESH_SBIN=$t/sbin NGINX_SITE_DIR=$t/conf.d
  export IH_SSHD=$b/sshd IH_SSHD_RUNDIR=$t/rundir IH_SUDOERS_DIR=$t/sudoers.d
  export IH_NTFY_ETC=$t/ntfy-etc IH_NTFY_LIB=$t/var/lib/ntfy IH_NTFY_CACHE=$t/var/cache/ntfy
  export HUB_HOST=203.0.113.10
  rm -f "$DEVMESH_ETC/hub.key"
}

install_hub() { bash "$REPO/server/install-hub.sh" --container "$@"; }

@test "--container never calls systemctl, ufw, fail2ban-client, iptables-save or apt-get" {
  run install_hub
  [ "$status" -eq 0 ]
  ! grep -E '^(systemctl|ufw|fail2ban-client|iptables-save|apt-get|dpkg|modprobe) ' "$STUB_LOG"
  [[ $output == *"container: fail2ban is not run here"* ]]
}

@test "--container still renders sshd_config, the WireGuard config and the nginx site" {
  run install_hub
  [ "$status" -eq 0 ]
  grep -q '^Port 2222$' "$DEVMESH_ETC/sshd_config"
  grep -q '^AllowUsers tunnel enroll dmadmin$' "$DEVMESH_ETC/sshd_config"
  grep -q '^PrivateKey = ' "$DEVMESH_WG_DIR/devmesh.conf"
  grep -q 'listen 8443 ssl' "$NGINX_SITE_DIR/devmesh-hub.conf"
  grep -q "$DEVMESH_ETC/tls/cert.pem" "$NGINX_SITE_DIR/devmesh-hub.conf"
  grep -q '^HUB_PIN=' "$DEVMESH_ETC/hub.conf"
  [ -s "$DEVMESH_HOST_KEY_PUB" ]
  grep -q '^enroll  ALL' "$IH_SUDOERS_DIR/devmesh"
}

@test "--container writes the ntfy config and keeps its state under the state volume" {
  run install_hub
  [ "$status" -eq 0 ]
  grep -q 'Generated by devmesh' "$IH_NTFY_ETC/server.yml"
  [ -L "$IH_NTFY_LIB" ]
  [ "$(readlink "$IH_NTFY_LIB")" = "$DEVMESH_STATE/ntfy" ]
  [ "$(readlink "$IH_NTFY_CACHE")" = "$DEVMESH_STATE/ntfy-cache" ]
  grep -q '^NTFY_TOKEN=tk_' "$DEVMESH_ETC/hub.conf"
  grep -q '^NTFY_URL=http://127.0.0.1:2586$' "$DEVMESH_ETC/hub.conf"
}

@test "--container is idempotent: the second run keeps the keys, the pin and the config" {
  install_hub
  pin=$(sed -n 's/^HUB_PIN=//p' "$DEVMESH_ETC/hub.conf")
  wgkey=$(<"$DEVMESH_ETC/hub.key")
  hostkey=$(<"$DEVMESH_HOST_KEY_PUB")
  run install_hub
  [ "$status" -eq 0 ]
  [ "$(sed -n 's/^HUB_PIN=//p' "$DEVMESH_ETC/hub.conf")" = "$pin" ]
  [ "$(<"$DEVMESH_ETC/hub.key")" = "$wgkey" ]
  [ "$(<"$DEVMESH_HOST_KEY_PUB")" = "$hostkey" ]
  ! grep -E '^(systemctl|ufw) ' "$STUB_LOG"
}

@test "--container in domain mode with a mounted certificate serves the full TLS site on 443" {
  export HUB_HOST=hub.example.test TLS_CERT=$BATS_TEST_TMPDIR/c.pem TLS_KEY=$BATS_TEST_TMPDIR/k.pem
  : >"$TLS_CERT"
  echo x >"$TLS_CERT"
  run install_hub
  [ "$status" -eq 0 ]
  grep -q 'listen 443 ssl' "$NGINX_SITE_DIR/devmesh-hub.conf"
  [ ! -e "$DEVMESH_ETC/.acme-pending" ]
}

@test "--container in domain mode without a certificate defers ACME to the entrypoint" {
  export HUB_HOST=hub.example.test ACME_EMAIL=me@example.test
  run install_hub
  [ "$status" -eq 0 ]
  [ -e "$DEVMESH_ETC/.acme-pending" ]
  grep -q 'acme-challenge' "$NGINX_SITE_DIR/devmesh-hub.conf"
  ! grep -q 'listen 443' "$NGINX_SITE_DIR/devmesh-hub.conf"
  ! grep -E '^(systemctl|certbot) ' "$STUB_LOG"
}

@test "without --container the same steps do call systemctl (the guard is the only difference)" {
  run bash -c 'grep -c "ih_systemctl\|IH_CONTAINER" "$1"' _ "$REPO/server/install-hub.sh"
  [ "$output" -gt 3 ]
  run bash -c 'source "$1/server/lib/common.sh"; ih_die(){ exit 1; }; IH_CONTAINER=0; eval "$(sed -n "/^ih_systemctl()/,/^}/p" "$1/server/install-hub.sh")"; ih_systemctl status x' _ "$REPO"
  grep -q '^systemctl status x$' "$STUB_LOG"
}
