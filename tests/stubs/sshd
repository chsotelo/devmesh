#!/usr/bin/env bash
# Test stub for sshd: logs the call, keeps a copy of the config, writes the PidFile of a
# long sleep (the "daemon"). STUB_SSHD_FAIL=1 fails like a bind error.
[[ -n ${STUB_LOG:-} ]] && printf 'sshd %s\n' "$*" >>"$STUB_LOG"
[[ ${STUB_SSHD_FAIL:-0} == 1 ]] && exit 1
cfg=""
while (($#)); do
  [[ $1 == -f ]] && cfg=$2
  shift
done
pidfile=$(awk '$1 == "PidFile" {print $2}' "$cfg")
# The "daemon" carries the config path in its command line, like the real sshd title.
nohup bash -c 'sleep 300; :' "$cfg" </dev/null >/dev/null 2>&1 3>&- &
printf '%s\n' "$!" >"$pidfile"
exit 0
